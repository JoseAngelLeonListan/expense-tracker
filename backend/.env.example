# Copia este archivo a .env y rellena los valores. NO subas .env a Git.
# (Solo para arrancar el backend fuera de Docker; con docker compose se usa el .env de la raíz.)

# Clave para firmar los tokens. Genérala con:  openssl rand -hex 32
SECRET_KEY=

# Base de datos (opcional). Por defecto, un archivo SQLite local.
# DATABASE_URL=sqlite:///./expenses.db
# Ejemplo con el PostgreSQL de docker compose (fase 6c):
# DATABASE_URL=postgresql+psycopg://expenses:cambia-esta-contrasena@127.0.0.1:5432/expenses

# Orígenes del frontend que pueden llamar a la API, separados por comas (opcional).
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Minutos de validez del token (opcional, por defecto 30).
# ACCESS_TOKEN_EXPIRE_MINUTES=30
