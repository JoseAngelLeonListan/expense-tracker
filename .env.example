# Copia este archivo a .env (en la raíz) y cambia los valores. NO subas .env a Git.
# Lo lee docker compose.

POSTGRES_USER=expenses
# Usa solo letras, números, - y _ (va dentro de una URL de conexión)
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=expenses

# Clave para firmar los tokens. Genérala con:  openssl rand -hex 32
SECRET_KEY=
